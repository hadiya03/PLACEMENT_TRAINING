def strongPassword(password):
    lower=False
    upper=False
    digit=False
    repeat=0
    for i in range(len(password)):
        if password[i].islower():
            lower=True
        if password[i].isupper():
            upper=True
        if password[i].isdigit():
            digit=True
    for i in range(1,len(password)-1):
        if password[i]==password[i+1] and password[i]==password[i-1]:
            repeat+=1
    miss=0
    if not lower:
        miss+=1
    if not upper:
        miss+=1
    if not digit:
        miss+=1
    leng=0
    if len(password)<6:
        leng=6-len(password)
    answer=max(miss,leng,repeat)
    return answer

str1=input()
print(strongPassword(str1))
